model Pool {
  address       String  @unique
  name          String
  dex           String  @default("Meteora")
  isBlacklisted Boolean @default(false)

  tokenXAddress String
  tokenX        Token  @relation("TokenX", fields: [tokenXAddress], references: [address])
  tokenYAddress String
  tokenY        Token  @relation("TokenY", fields: [tokenYAddress], references: [address])

  config Json?

  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots PoolSnapshot[]

  @@index([address])
}
